rules_version = '2';

// Rules for the hbgapp-c3c88-amore-media bucket only.
service firebase.storage {
  match /b/{bucket}/o {
    // Chat media: only the two people in the match. A match id is the two
    // user ids joined by '_', so membership is checked from the path itself
    // (no Firestore lookup needed). Files are addressed by path through the
    // SDK, never shared download URLs, so these rules apply to every read.
    // View-once files are deleted by the receiver after viewing.
    match /amore_chats/{matchId}/{fileName} {
      function inMatch() {
        return request.auth != null && request.auth.uid in matchId.split('_');
      }
      allow read: if inMatch();
      allow create: if inMatch()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow update: if false;
      allow delete: if inMatch();
    }

    // Private profile photos and the 30s / 2-minute videos: owner only.
    // A 2-minute front-camera recording can reach ~250 MB at 1080p.
    match /users/{uid}/private/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 10 * 1024 * 1024
                && request.resource.contentType.matches('image/.*'))
            || (request.resource.size < 400 * 1024 * 1024
                && request.resource.contentType.matches('video/.*')));
    }

    // Option images for picture-answer questions; uploaded in the admin panel.
    match /amore_question_media/{questionId}/{fileName} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.token.get('amoreAdmin', false) == true
        && request.auth.token.get('email_verified', false) == true;
      allow create, update: if request.auth != null
        && request.auth.token.get('amoreAdmin', false) == true
        && request.auth.token.get('email_verified', false) == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 10 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
